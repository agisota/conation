{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "rox"
  ],
  "model": "rox/gemini-2.5-flash",
  "provider": {
    "rox": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Conation OmniRoute",
      "options": {
        "baseURL": "http://127.0.0.1:8701/v1",
        "apiKey": "conation-local-proxy"
      },
      "models": {
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (default)"
        },
        "nemotron-3-ultra": {
          "name": "Nemotron 3 Ultra (fallback)"
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (fallback)"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio",
        "--toolsets",
        "issues,pull_requests"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "enabled": true
    }
  }
}
