# Conation self-host — single server
# cp .env.selfhost.example .env.selfhost && $EDITOR .env.selfhost
# Then: docker compose -f docker/docker-compose-databases.yml -f docker/docker-compose.yml -f docker/docker-compose.selfhost.yml --env-file .env.selfhost up -d

# Domain & TLS
CONATION_DOMAIN=conation.dev
# For local without public DNS/LE: CADDY_TLS=tls internal
CADDY_TLS=tls
# Comma-separated origins allowed (CORS). Add your domains.
CORS_EXTRA_ORIGINS=https://conation.dev,https://app.conation.dev

# Database / Redis / Infra (docker hostnames)
DATABASE_URL=postgres://user:password@postgres:5432/conationdb
DATABASE_URL_READONLY=postgres://user:password@postgres:5432/conationdb
REDIS_URI=redis://redis:6379
OPENSEARCH_URL=http://search:9200
OPENSEARCH_USERNAME=conationuser
OPENSEARCH_PASSWORD=local
KAFKA_BROKERS=kafka:29092

# Storage (MinIO replaces S3)
MINIO_ROOT_USER=conation
MINIO_ROOT_PASSWORD=conation12345
LOCAL_AWS_URL=http://minio:9000
AWS_ACCESS_KEY_ID=conation
AWS_SECRET_ACCESS_KEY=conation12345
AWS_REGION=us-east-1
DOCUMENT_STORAGE_BUCKET=doc-storage
ATTACHMENT_BUCKET=conation-email-attachments
STATIC_STORAGE_BUCKET=static-file-storage
DOCX_DOCUMENT_UPLOAD_BUCKET=docx-upload
UPLOAD_STAGING_BUCKET=bulk-upload-staging
CALL_RECORDING_S3_BUCKET=conation-call-recording

# Mail (Stalwart — replaces Gmail)
EMAIL_PROVIDER=stalwart
STALWART_JMAP_URL=http://stalwart:8080
STALWART_ADMIN_URL=http://stalwart:8080/api
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=conation-admin-123
# Same recovery identity in the format expected by Stalwart. Replace both
# example passwords before exposing the server.
STALWART_RECOVERY_ADMIN=admin:conation-admin-123
# SMTP for outbound (SES -> Stalwart)
SMTP_HOST=stalwart
SMTP_PORT=587
SENDER_BASE_ADDRESS=conation.dev

# Auth (FusionAuth)
FUSIONAUTH_BASE_URL=http://fusionauth:9011
FUSIONAUTH_PUBLIC_URL=http://localhost:9011
FUSIONAUTH_API_KEY=local-fusionauth-key
FUSIONAUTH_CLIENT_ID=local-client-id
FUSIONAUTH_CLIENT_SECRET_KEY=local-client-secret
BASE_URL=https://conation.dev
AUDIENCE=local-client-id
ISSUER=https://conation.dev
JWT_SECRET_KEY=local-jwt-secret-change-me

# LLM (rox.one — user provides key in UI, server holds only base URL)
ROX_BASE_URL=https://api.rox.one/v1
# Optional server fallback key (if user not set). Better per-user.
ROX_API_KEY=
ANTHROPIC_API_KEY=local-anthropic-key
OPENAI_API_KEY=local-openai-key
COHERE_API_KEY=local-cohere-key

# Internal auth
INTERNAL_API_SECRET_KEY=local
INTERNAL_API_KEY=local
INTERNAL_AUTH_KEY=local
DOCUMENT_STORAGE_SERVICE_AUTH_KEY=local
DOCUMENT_PERMISSION_JWT=local
INTERNAL_CALL_SECRET=local
URL_SIGNING_HMAC=local

# Optional integrations (set if needed)
LIVEKIT_SERVER_URL=http://localhost:7880
LIVEKIT_API_KEY=local-livekit-key
LIVEKIT_API_SECRET=local-livekit-secret
GITHUB_SYNC_APP_CLIENT_ID=local-github-sync-client
GITHUB_SYNC_APP_PEM_SECRET_KEY=local-github-sync-pem
STRIPE_SECRET_KEY=local-stripe-secret
STRIPE_PRICE_ID=local-stripe-price

# Frontend
FRONTEND_PORT=3000
MCP_PUBLIC_URL=http://localhost:8090/cognition
VITE_CONATION_DOMAIN=conation.dev
VITE_ROX_BASE_URL=https://api.rox.one/v1
VITE_DEFAULT_MODEL=rox/gpt-5.6-terra
VITE_DEFAULT_LOCALE=ru

# Caddy / ports
COMPOSE_PROJECT_NAME=conation
