# Experimental MinIO/Stalwart/Caddy overlay configuration.
#
# This is intentionally not a complete application environment. Start the
# supported local baseline with `bash .cursor/stack.sh`; validate this overlay
# with `just selfhost-overlay-check`. Do not commit a copied .env.selfhost.

# Local hostnames and loopback-only bindings. Changing SELFHOST_BIND_ADDRESS to
# 0.0.0.0 exposes unauthenticated development services and is unsupported.
CONATION_DOMAIN=conation.localhost
SELFHOST_BIND_ADDRESS=127.0.0.1
SELFHOST_HTTP_PORT=8088
LOCAL_PROXY_PORT=8090

# The isolated overlay keeps LocalStack because the application currently uses
# one shared endpoint for S3/SQS/DynamoDB/KMS. MinIO cannot replace only S3 yet.
LOCALSTACK_PORT=4566

# Isolated MinIO evaluation. Replace these examples in ignored .env.selfhost.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password

# Isolated Stalwart bootstrap evaluation. The recovery credential is consumed
# by the container, but application account provisioning/JMAP sync is not wired.
STALWART_SMTP_PORT=2525
STALWART_SUBMISSION_PORT=2587
STALWART_IMAPS_PORT=2993
STALWART_SIEVE_PORT=4190
STALWART_HTTP_PORT=18081
STALWART_RECOVERY_ADMIN=admin:replace-with-a-long-random-recovery-password

# Post-bootstrap operator action only; these variables are not consumed by
# Compose. Inject their values from a secret store before running
# `just selfhost-provision-support-mailboxes` and unset them afterwards.
# Prefer STALWART_TOKEN; alternatively set STALWART_USER/STALWART_PASSWORD.
# STALWART_TOKEN=
# STALWART_USER=
# STALWART_PASSWORD=
# CONATION_STALWART_PYTHIA_PASSWORD=
# CONATION_STALWART_TARS_PASSWORD=
# CONATION_STALWART_RAMZAN_KADYROV_PASSWORD=
