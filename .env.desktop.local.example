# Copy to .env.desktop.local (gitignored) or `source` this file on the MacBook.
# Desktop Tauri bakes these into the native + web bundle at build time.
#
# Pre-filled for the Conation Linux server (Sep 2026). Prefer Tailscale.
# localhost:8090 on that server is dynacat — never use it as the origin.

CONATION_CLIENT_PROFILE=standalone

# Primary: Tailscale :8090 (TCP serve -> conation-dev operator :24009).
CONATION_OPERATOR_ORIGIN=http://100.89.19.82:8090
VITE_CONATION_OPERATOR_ORIGIN=http://100.89.19.82:8090

# Alternate if the MacBook is not on Tailscale (passwordless local-dev is exposed).
# CONATION_OPERATOR_ORIGIN=http://173.212.222.197:8090
# VITE_CONATION_OPERATOR_ORIGIN=http://173.212.222.197:8090

# Extra hosts the Tauri HTTP plugin may call (comma-separated origins).
CONATION_TAURI_HTTP_ORIGINS=http://100.89.19.82:8090,http://173.212.222.197:8090,http://100.89.19.82:24009,http://173.212.222.197:24009

# Login codes land in Mailpit (not a real inbox).
CONATION_MAILPIT_URL=http://100.89.19.82:24008
CONATION_FUSIONAUTH_URL=http://100.89.19.82:24005

# Direct operator (no 8090 forwarder): http://100.89.19.82:24009
# Cursor Cloud /root/macro stack (alternate): http://100.89.19.82:23009
