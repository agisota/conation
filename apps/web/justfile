# iOS: dev-facing, for testing in Simulator. Honors PORT like the web dev
# server (`PORT=3001 just ios-dev`): the vite server picks PORT up through
# beforeDevCommand's environment, and the --config merge points the webview's
# devUrl at the same port.
ios-dev: ios-prepare
    #!/usr/bin/env bash
    set -euo pipefail
    PORT="${PORT:-3000}"
    cd tauri/src-tauri && cargo tauri ios dev --open \
      --config "{\"build\":{\"devUrl\":\"http://localhost:${PORT}\"}}" \
      -- --no-default-features

# iOS: prod-facing build, with bundle auto-update turned off, for testing locally on actual iPhone
ios-build-no-update: ios-prepare
    bun scripts/run-tauri-build.ts ios --open -- --no-default-features

# iOS: build for release
ios-build: ios-prepare
    bun scripts/run-tauri-build.ts ios --open

# iOS generated project prep. Keep native bundle metadata in sync with
# tauri.ios.conf.json, then prepare ignored local Swift dependencies.
ios-prepare:
    bun scripts/sync-ios-bundle-metadata.mjs
    bun scripts/prepare-tauri-ios-api.mjs

# Xcode resolves SwiftPM packages before Tauri's Rust build script can generate
# local plugin Swift dependencies, so prepare the ignored Tauri iOS API first.
ios-prepare-tauri-api:
    bun scripts/prepare-tauri-ios-api.mjs

# Tauri build hook (run automatically via beforeDevCommand) — not meant to be run directly
[private]
dev-tauri: ensure-cache-wasm
    CONATION_TAURI_APP_ENV=development bun scripts/tauri-rust-profile.ts
    bun run --bun dev

# Run the app through the standalone local reverse proxy.
# This assumes you have followed the docs/RUNNING_LOCALLY.md instructions.
port := '3000'

local:
    PORT='{{port}}' VITE_CONATION_OPERATOR_ORIGIN='http://localhost:8090' bun run --bun dev

# All app builds need the gitignored wasm pkg (src/lib/graphql-cache/wasm):
# without it the cache worker's dynamic import 404s at runtime and the
# normalized cache silently degrades to network-only.
#
# The vite build's chunk-rendering peaks right at node's default ~4GB heap
# cap, so CI builds flap with "Ineffective mark-compacts near heap limit".
# Lift the ceiling; peak usage stays the same, it just stops aborting.
node_heap := "--max-old-space-size=6144"

build-dev: build-cache-wasm build-agent-fold-wasm
    VITE_CONATION_CLIENT_PROFILE=standalone VITE_CONATION_OPERATOR_ORIGIN=same-origin MODE=development NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist

build-staging: build-cache-wasm build-agent-fold-wasm
    VITE_CONATION_CLIENT_PROFILE=standalone VITE_CONATION_OPERATOR_ORIGIN=same-origin MODE=staging NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist

build-prod: build-cache-wasm build-agent-fold-wasm
    VITE_CONATION_CLIENT_PROFILE=standalone VITE_CONATION_OPERATOR_ORIGIN=same-origin MODE=production NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist
    bun scripts/assert-standalone-artifact.ts dist

check-standalone-artifact:
    bun scripts/assert-standalone-artifact.ts dist

# Native standalone bundles default to https://conation.dev. Override with
# CONATION_OPERATOR_ORIGIN and, only when required for direct object URLs,
# comma-separated CONATION_TAURI_HTTP_ORIGINS.
tauri-build-standalone:
    CONATION_CLIENT_PROFILE=standalone bun scripts/run-tauri-build.ts desktop

# Desktop/macOS bundle aimed at a running local operator proxy (just stack /
# just run_local, typically :8090). Refuses to default to conation.dev so a
# Mac build cannot silently talk to the public host. Required:
#   CONATION_OPERATOR_ORIGIN=http://<this-host>:8090
# Optional extra allowlist:
#   CONATION_TAURI_HTTP_ORIGINS=http://<minio-or-object-host>:9000
tauri-build-local-stack:
    CONATION_CLIENT_PROFILE=standalone CONATION_NATIVE_TARGET=local-stack bun scripts/run-tauri-build.ts desktop

# Tauri build hook (run automatically via beforeBuildCommand) — not meant to be run directly
[private]
build-tauri: build-cache-wasm build-agent-fold-wasm
    CONATION_TAURI_APP_ENV=production bun scripts/tauri-rust-profile.ts
    VITE_CONATION_CLIENT_PROFILE="${VITE_CONATION_CLIENT_PROFILE:-${CONATION_CLIENT_PROFILE:-standalone}}" VITE_CONATION_OPERATOR_ORIGIN="${VITE_CONATION_OPERATOR_ORIGIN:-${CONATION_OPERATOR_ORIGIN:-https://conation.dev}}" MODE=production NODE_ENV=production NODE_OPTIONS="{{node_heap}}" bun run --bun build
    bun scripts/cache-wasm/cli.ts package-dist --dist dist
    bun scripts/cache-wasm/cli.ts remove-sidecar --dist dist

# Build the bundle, zip it, and install it at
# tooling/native_app_server/app-archive.zip for the bundle
# updater test server. The server hashes the archive at request time, so no
# checksum wiring is needed.
dist-archive: build-prod
    #!/usr/bin/env bash
    set -euo pipefail
    TARGET="$(cd {{ justfile_directory() }}/../../tooling/native_app_server && pwd)/app-archive.zip"
    rm -f "$TARGET"
    (cd dist && zip -qr "$TARGET" . -x '*cache_wasm_bg*.wasm.br')
    echo "Archive: $TARGET"

