{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "conation",
  "version": "../../package.json",
  "identifier": "dev.conation.app",
  "build": {
    "frontendDist": "../../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": {
      "script": "just dev-tauri",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "just build-tauri",
      "cwd": "../.."
    }
  },
  "app": {
    "windows": [
      {
        "title": "Conation",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPCACHE/ios-share-staging/**",
            "$APPCACHE/ios-pasteboard-staging/**",
            "$APPCACHE/ios-photo-library-staging/**"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "conation"
          ],
          "appLink": false
        },
        {
          "host": "conation.dev",
          "pathPrefix": [
            "/app"
          ]
        },
        {
          "host": "dev.conation.dev",
          "pathPrefix": [
            "/app"
          ]
        },
        {
          "host": "staging.conation.dev",
          "pathPrefix": [
            "/app"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "conation"
        ]
      }
    }
  }
}
