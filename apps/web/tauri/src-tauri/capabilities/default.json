{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://conation.dev/**"
        },
        {
          "url": "http://localhost:*"
        }
      ]
    },
    "opener:default",
    "deep-link:default",
    "websocket:default",
    "safe-area-insets:default",
    "notification:default",
    "notifications:default",
    "os:default",
    "log:default",
    "device-info:default"
  ]
}
