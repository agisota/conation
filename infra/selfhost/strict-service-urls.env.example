# TEMPLATE ONLY — not a working deployment configuration.
#
# Replace every `conation.operator.example` / `agent-proxy.operator.example`
# value with an operator-owned DNS name and implement the corresponding ingress
# route. Do not copy this file unchanged and do not put secrets in it.
#
# `strict-self-host` requires an override whenever a typed service URL is
# resolved. This template deliberately supplies all 19 currently exported
# service URL overrides, including the currently unused agent-proxy endpoint.
CONATION_SERVICE_URL_PROFILE=strict-self-host

# Browser-facing origin and same-origin HTTP ingress paths.
OVERRIDE_APP_SERVICE_URL=https://conation.operator.example
OVERRIDE_AUTH_SERVICE_URL=https://conation.operator.example/auth
OVERRIDE_PDF_SERVICE_URL=https://conation.operator.example/pdf
OVERRIDE_DOCUMENT_STORAGE_SERVICE_URL=https://conation.operator.example/dss
OVERRIDE_CONNECTION_GATEWAY_URL=https://conation.operator.example/connection-gateway
OVERRIDE_DOCUMENT_COGNITION_SERVICE_URL=https://conation.operator.example/cognition
OVERRIDE_NOTIFICATION_SERVICE_URL=https://conation.operator.example/notification
OVERRIDE_STATIC_FILE_SERVICE_URL=https://conation.operator.example/static-file
OVERRIDE_AGENT_HARNESS_SERVICE_URL=https://conation.operator.example/agent-harness
OVERRIDE_UNFURL_SERVICE_URL=https://conation.operator.example/unfurl
OVERRIDE_CONTACTS_SERVICE_URL=https://conation.operator.example/contacts
OVERRIDE_EMAIL_SERVICE_URL=https://conation.operator.example/email
OVERRIDE_IMAGE_PROXY_SERVICE_URL=https://conation.operator.example/image-proxy
OVERRIDE_LEXICAL_SERVICE_URL=https://conation.operator.example/lexical
OVERRIDE_AI_EDITING_WORKER_URL=https://conation.operator.example/ai-editing

# Browser-facing WebSocket ingress paths. Keep ws/wss scheme; HTTP(S) is rejected.
OVERRIDE_WEBSOCKET_SERVICE_URL=wss://conation.operator.example/websocket
OVERRIDE_CONNECTION_GATEWAY_WEBSOCKET_URL=wss://conation.operator.example/connection-gateway
OVERRIDE_SYNC_SERVICE_URL=wss://conation.operator.example/sync

# No public same-origin agent-proxy route is supplied by the local ingress.
# This endpoint is currently unused, but strict mode still requires a valid
# operator-owned WebSocket URL if code resolves it.
OVERRIDE_AGENT_PROXY_WEBSOCKET_URL=wss://agent-proxy.operator.example
